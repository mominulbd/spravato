# /var/www/spravato/shared/nginx/site-upstream.conf — generated by
# `deploy/deploy.sh` (setup creates it, every release rewrites it). The port
# is the Next.js instance that currently serves the site: 3000 or 3001
# (systemd spravato-site@<port>), or always 3000 under pm2. Do not edit by
# hand; `deploy.sh status` shows which instance is live.
upstream spravato_site {
    server 127.0.0.1:3000;
    keepalive 16;
}
