# One run of Laravel's scheduler: pages:publish-scheduled (every minute),
# media:purge-trash and consultations:purge (nightly). Started every minute
# by spravato-scheduler.timer — the systemd form of the usual
#   * * * * * cd /var/www/spravato/current && php artisan schedule:run
#
# Install with the timer (deploy/README.md):
#   sudo cp deploy/systemd/spravato-scheduler.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now spravato-scheduler.timer
[Unit]
Description=Spravato Laravel scheduler (one run)
After=network.target mysql.service

[Service]
Type=oneshot
User=spravato
Group=spravato
WorkingDirectory=/var/www/spravato/current
ExecStart=/usr/bin/php /var/www/spravato/current/artisan schedule:run --no-interaction
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
SyslogIdentifier=spravato-scheduler
