# The Next.js site (site/), built with `output: "standalone"`.
# Install: sudo cp deploy/systemd/spravato-site.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now spravato-site
[Unit]
Description=Spravato public site (Next.js)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/spravato/current/site/.next/standalone/site
# Same values as site/.env.local in development (site/.env.example).
EnvironmentFile=/var/www/spravato/shared/site.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
