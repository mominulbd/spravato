# ─────────────────────────────────────────────────────────────────────────────
# Spravato — Laravel (API + admin). Copy to .env, then `php artisan key:generate`.
# The admin is the root of Laravel's origin: sign in at http://localhost:8000/login.
# The Next.js site (../spravato-app, its own .env.local) runs on its own origin.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Spravato · UPTMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The public origin, i.e. the site's address, not Laravel's own port.
APP_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spravato
DB_USERNAME=root
DB_PASSWORD=

# 30 idle minutes, encrypted, in the database (docs/ARCHITECTURE.md §5).
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
# The origin staff use for the admin: the site's address.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
# Proxies whose X-Forwarded-* headers Laravel trusts: `next dev` locally,
# the reverse proxy in production. Comma-separated.
TRUSTED_PROXIES=127.0.0.1,::1

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

AUTH_TWO_FACTOR_LOGIN=false
CLINIC_TIMEZONE=America/Los_Angeles

# The Next.js site. Secrets: `openssl rand -hex 32`, same values in ../spravato-app/.env.local
# (REVALIDATE_SECRET and SITE_TOKEN).
FRONTEND_URL=http://localhost:3000
FRONTEND_REVALIDATE_SECRET=
FRONTEND_SITE_TOKEN=

# Cloudflare Turnstile for the consultation form; empty turns it off.
TURNSTILE_SECRET_KEY=
