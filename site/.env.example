# ─────────────────────────────────────────────────────────────────────────────
# Spravato public site (Next.js, site/). Copy to site/.env.local.
# The site and Laravel share one domain (docs/DEVELOPMENT-PLAN.md §1).
# ─────────────────────────────────────────────────────────────────────────────

# Laravel's own address, reached server-side only. In development Next.js also
# forwards /admin, /api/v1, /sanctum, /build, /storage and /up to it, so the
# whole product runs on the site's origin. In production a reverse proxy does
# that instead.
LARAVEL_URL=http://127.0.0.1:8000

# Laravel API base, read only on the server. Include the /api/v1 prefix.
API_URL=http://127.0.0.1:8000/api/v1

# Public origin: canonical URLs, Open Graph, sitemap. Same as Laravel's APP_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engines may index the site only when this is "true" (production, at launch).
ALLOW_INDEXING=false

# Shared with Laravel (FRONTEND_REVALIDATE_SECRET): signs the on-publish webhook.
REVALIDATE_SECRET=

# Shared with Laravel (FRONTEND_SITE_TOKEN): lets the consultation form forward the visitor's IP.
SITE_TOKEN=

# Cloudflare Turnstile site key for the consultation dialog (public). Pair it
# with Laravel's TURNSTILE_SECRET_KEY; leave both empty to turn the check off.
# The script loads only once the dialog opens.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Content Security Policy (lib/csp.ts, set by proxy.ts). Media files come from
# Laravel's APP_URL/storage. When that is the site's own origin (production
# behind one domain, or `next dev` rewrites) leave this empty. Otherwise list
# the origin(s), comma separated, e.g. the e2e stack's http://127.0.0.1:8124
# or a CDN in front of the media disk.
MEDIA_ORIGINS=
